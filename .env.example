APP_NAME=FORM/01 Middleware
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_HASH_SCHEME=pbkdf2_sha256
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Aiven service URI or standard PostgreSQL connection URL
SERVICE_URI=postgres://avnadmin:your-password@your-aiven-host:port/defaultdb?sslmode=require
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/form01
# AIVEN_DATABASE_URL=postgresql+asyncpg://user:password@host:port/database?sslmode=require

# Fallback discrete PostgreSQL settings if no connection URL is set
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=form01
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_SSLMODE=require
